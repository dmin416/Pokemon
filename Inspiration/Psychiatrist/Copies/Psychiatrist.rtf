{\b
[Nidoqueen]}\par\pard\plain\hyphpar} {	
{\b
[Type: Poison, Ground]}\par\pard\plain\hyphpar} {	
{\b
[Ability: Sheer Force]}\par\pard\plain\hyphpar} {	
{\b
[Moves Known: Superpower, Growl, Poison Sting, Scratch, Tail Whip, Fury Swipes, Mega Punch, Fire Punch, Thunder Punch, Ice Punch, Thunderbolt, Surf, Earthquake\u8230?]}\par\pard\plain\hyphpar} {	
{\b
[Mood: Sad, Jealous (Don't let me see anything lovey-dovey in front of me!)]}\par\pard\plain\hyphpar} {	
